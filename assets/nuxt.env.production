# Production environment template, copied to each app's .env.production.
#
# NUXT_PUBLIC_API_BASE is normally derived automatically by `main.sh deploy`
# from domains[api] (or from app_env["server:app:NUXT_PUBLIC_API_BASE"]). The
# value below is only a fallback: `deploy` refuses to ship a bundle that still
# points at localhost or example.com unless --allow-placeholder-env is passed.
#
# For a same-origin setup (frontend and API behind one nginx/caddy host), set
# the app_env override to `same-origin`, which becomes an empty base URL so
# requests go to the current origin.
ENABLE_PWA=false
ENABLE_SEO=false
NUXT_PUBLIC_API_BASE=https://api.example.com
NUXT_PUBLIC_SITE_URL=https://example.com
